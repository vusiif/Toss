# Build artifacts
/target

# Documentation — only README.md is version-controlled.
# Everything else (*.md notes, docs/, doc/) is excluded from commits.
*.md
!README.md
docs/
doc/

# RustRover / IntelliJ volatile state
# (.idea/.gitignore already covers shelf/, workspace.xml, httpRequests/, queries/,
#  dataSources/; these are belt-and-braces for anything that leaks past it.)
.idea/workspace.xml
.idea/tasks.xml
.idea/usage.statistics.xml
.idea/shelf/
.idea/httpRequests/
.idea/dictionaries/
.idea/caches/
.idea/sonarlint/
.idea/sonarlintIssues.xml

# Local scratch
*.log
*.tmp
