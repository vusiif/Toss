# Build artifacts
/target

# Documentation — only the files whitelisted here are version-controlled.
# Everything else (*.md notes, docs/, doc/) stays out of commits.
# ARCHIVE_BACKEND.md is whitelisted because it constrains future agents;
# a rule nobody can see after cloning is not a rule.
*.md
!README.md
!ARCHIVE_BACKEND.md
docs/
doc/

# Vendored third-party source is committed verbatim (§25), including its own
# doc/ and *.md files — those belong to upstream, not to this project, and a
# release whose source is half-ignored is not reproducible.
!third_party/**

# RustRover / IntelliJ volatile state
# (.idea/.gitignore already covers shelf/, workspace.xml, httpRequests/, queries/,
#  dataSources/; these are belt-and-braces for anything that leaks past it.)
.idea/workspace.xml
.idea/tasks.xml
.idea/usage.statistics.xml
.idea/shelf/
.idea/httpRequests/
.idea/dictionaries/
.idea/caches/
.idea/sonarlint/
.idea/sonarlintIssues.xml

# Local scratch
*.log
*.tmp
