# Normalize line endings. Source is always checked in as LF so that
# `cargo fmt --check` behaves identically on Windows and Linux CI.
* text=auto eol=lf

# ...except vendored third-party source, which must reach the index exactly
# as upstream shipped it. Rewriting its line endings would make "committed
# verbatim" false and make diffing against upstream pointless (§25).
third_party/** -text

*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.pdf  binary
*.zip  binary
*.7z   binary
*.rar  binary
