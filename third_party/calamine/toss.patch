+// Toss evaluation patch: resolve from xl/workbook.xml, within package root.
+fn resolve_sheet_target(target: &str) -> Result<String, XlsxError> {
+    let invalid = || XlsxError::Unrecognized {
+        typ: "sheet:target",
+        val: target.to_owned(),
+    };
+    if target.contains(['\\', ':', '?', '#', '\0']) {
+        return Err(invalid());
+    }
+    // Preserve calamine's existing acceptance of xl/-prefixed package paths.
+    let mut parts = if target.starts_with('/') || target.starts_with("xl/") {
+        Vec::new()
+    } else {
+        vec!["xl"]
+    };
+    for part in target.split('/') {
+        match part {
+            "" | "." => (),
+            ".." => {
+                parts.pop().ok_or_else(invalid)?;
+            }
+            _ => parts.push(part),
+        }
+    }
+    if parts.is_empty() {
+        return Err(invalid());
+    }
+    Ok(parts.join("/"))
+}
